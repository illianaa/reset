# Reset environment variables. Everything here is optional.
#
# You don't need any of these to use Reset. `resetctl setup` saves your settings, including the
# Telegram bot token, in ~/.reset/config.json, which only your user account can read.
#
# To override something: copy this file to `.env` in this folder (git ignores it) and uncomment
# a line. Real environment variables take precedence over `.env`. The background service reads
# `.env` too, so put anything it needs here rather than only in your shell profile.

# Where Reset keeps its database, settings and logs.
# RESET_HOME=~/.reset

# Your Telegram bot token from @BotFather. If set, it's used instead of the saved token and is
# never written to config.json.
# RESET_TELEGRAM_BOT_TOKEN=

# Paths to the AI tools, if Reset picks the wrong ones.
# RESET_CODEX_BIN=/path/to/codex
# RESET_CLAUDE_BIN=/path/to/claude

# Codex's own settings folder. Reset reads the model you chose in Codex from here.
# CODEX_HOME=~/.codex

# Full error tracebacks in the background service log (~/.reset/logs/daemon.log).
# RESET_DEBUG=1
